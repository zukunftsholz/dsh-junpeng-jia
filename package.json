{
  "name": "dsh-junpeng-jia",
  "version": "0.1.0",
  "description": "Deep compatibility inspection for third-party DSH plugins, with a graded dual-factor verdict and an opt-in GitHub update request (issue) flow.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "compatibility",
    "issue",
    "update"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zukunftsholz/dsh-junpeng-jia.git"
  },
  "homepage": "https://github.com/zukunftsholz/dsh-junpeng-jia",
  "bugs": {
    "url": "https://github.com/zukunftsholz/dsh-junpeng-jia/issues"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": ">=3.18.2 <3.19.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "license": "MIT"
}
